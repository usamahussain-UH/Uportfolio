## Frontend
# Enable "Live" tab in the portfolio AI Playground
VITE_LIVE_CHAT=1

## Backend (server/index.js)
# Your OpenAI API key (keep this secret, never commit .env)
OPENAI_API_KEY=YOUR_KEY_HERE

# Optional: choose model
OPENAI_MODEL=gpt-4o-mini

# Optional: server port (must match vite proxy target port)
PORT=8787

